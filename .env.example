# MongoDB connection string. Local default shown; replace with an Atlas URI
# (mongodb+srv://...) if you're not running Mongo locally.
MONGODB_URI=mongodb://127.0.0.1:27017/e2ee-chat

# Secret used to sign login session tokens (JWT). Change this to a long
# random string before deploying anywhere real.
JWT_SECRET=change-this-to-a-long-random-string

PORT=3000

# Origin(s) allowed to call this backend from a different origin — needed once
# the frontend is bundled inside the native app or hosted separately from this
# server. "*" (default) allows any origin; set to your real frontend URL(s)
# once you're deploying for real, e.g. https://your-frontend.example.com
ALLOWED_ORIGIN=*

# How many days a message is kept before it's permanently auto-deleted
# (MongoDB TTL index - see models/Message.js). 30-60 is a reasonable range.
MESSAGE_RETENTION_DAYS=45

# Max people allowed in one Quick Room. Rooms use a full WebRTC mesh (every
# pair of participants opens a direct connection), so this doesn't scale
# forever - 6 is a reasonable ceiling for a small group call.
ROOM_MAX_SIZE=6

# How long an EMPTY Quick Room stays valid before it is erased completely
# (seconds). Default 120 = 2 minutes.
ROOM_EMPTY_TTL_SECONDS=120

# Push notifications for the Android app (works even when the app is closed).
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Paste the whole JSON on one line, OR base64-encode the file
# (e.g. `base64 -w0 key.json`) and paste that. Leave empty to disable push.
FIREBASE_SERVICE_ACCOUNT=

# ================= Security (set these in production) =================
NODE_ENV=production
# REQUIRED in production (server refuses to start without it): 32+ random characters.
#   openssl rand -hex 32
JWT_SECRET=
# Login sessions last this long (default 14d).
TOKEN_TTL=14d
# Secret "pepper" for the one-way phone-number fingerprints. Set once, keep forever
# (changing it makes existing numbers unmatchable).   openssl rand -hex 32
PHONE_PEPPER=
# Exact web origin(s) allowed to call the API, comma separated. The Android app is always allowed.
ALLOWED_ORIGIN=https://your-site.example.com
# 1 when behind a host's load balancer (Render, Railway, Heroku...), 0 if Node is exposed directly.
TRUST_PROXY=1
# Redirect http -> https in production (set 0 only for a local production test).
FORCE_HTTPS=1
# Log Content-Security-Policy violations instead of blocking (use briefly if something breaks).
CSP_REPORT_ONLY=0
# Encrypted messages are kept on the server at most this long (default 14 days).
MESSAGE_RETENTION_DAYS=14
